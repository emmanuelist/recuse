# Copy to .env.local. Never commit .env.local.

# --- Gemini (free tier, no card — aistudio.google.com/apikey) ---
GEMINI_API_KEY=

# --- Foxit (500 credits/YEAR shared across all Foxit APIs — see AGENTS.md §4) ---
FOXIT_CLIENT_ID=
FOXIT_CLIENT_SECRET=
FOXIT_ESIGN_API_KEY=
FOXIT_WEBHOOK_SECRET=

# --- Nutrient DWS (use Data Extraction, not Processor) ---
NUTRIENT_API_KEY=

# --- SerpApi (250 searches/month, 50/hour) ---
SERPAPI_API_KEY=

# --- Neon Postgres ---
DATABASE_URL=

# --- Public base URL. Required: the eSign webhook must reach a public HTTPS endpoint. ---
NEXT_PUBLIC_APP_URL=

# Local development only. MUST be unset in production and during the demo.
# Replays captured real responses from evidence/api/ to conserve Foxit credits.
# Replay uses recorded responses only — never hand-authored fixtures.
RECUSE_REPLAY_CAPTURED=
